{
  "name": "thither",
  "version": "1.0.0",
  "description": "A fuzzy-matching address-bar launcher: one static page, one language core.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "repl": "node scripts/repl.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dsl.json && tsc --noEmit -p scripts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run lint:boundaries && pnpm run test && pnpm run build",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.27.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "fzf": "0.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@swc/core": "1.16.2",
    "@total-typescript/shoehorn": "0.1.2",
    "@types/node": "24.13.6",
    "dependency-cruiser": "18.4.0",
    "happy-dom": "^20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
