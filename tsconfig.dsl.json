{
  // ADR-0001's client-agnostic core, held by the compiler: no DOM lib, so
  // localStorage/document/window are type errors inside src/dsl.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"]
  },
  // src/lib keeps DOM types in the repo-wide pass; the files src/dsl actually
  // imports are pulled into this program too, so DOM-using utilities cannot
  // leak into the core.
  "include": ["src/dsl"]
}
